# Private owner and seeded Jeffrey resources
AI_RUNTIME=local_codex
# Raw private Sites identity returned by /api/whoami; it does not need to be a UUID.
PRIVATE_AUTH_USER_ID=
# Stable UUID used only inside Supabase tables.
PRIVATE_USER_ID=11111111-1111-4111-8111-111111111111
DEFAULT_CHARACTER_ID=22222222-2222-4222-8222-222222222222
DEFAULT_CONVERSATION_ID=33333333-3333-4333-8333-333333333333

# Optional legacy cloud runtime only. Leave blank for local_codex.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# DeepSeek-only chat preview — server only, no Supabase history or knowledge
PREVIEW_MODE=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# iPhone/iPad Web Push and proactive-contact scheduler
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
PROACTIVE_CRON_SECRET=

# Legacy cloud development agent only. Zero-key delivery keeps this disabled and blank.
DEVELOPMENT_AGENT_ENABLED=false
GITHUB_REPOSITORY=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
DEVELOPMENT_CALLBACK_SECRET=
DEVELOPMENT_APPROVAL_SECRET=
DEVELOPMENT_TASK_MAX_MINUTES=20

# Jeffrey Local — keep disabled until the customer's Mac helper passes acceptance
LOCAL_COMPUTER_AGENT_ENABLED=false
LOCAL_AGENT_PAIRING_SECRET=
LOCAL_AGENT_DEVICE_TOKEN_SECRET=
LOCAL_AGENT_APPROVAL_SECRET=
LOCAL_AGENT_TASK_TTL_MINUTES=15
LOCAL_AGENT_LEASE_SECONDS=60
LOCAL_AGENT_MIN_VERSION=0.1.0
